

generator client{
    provider="prisma-client-js"
}

datasource db{
    provider = "postgresql"
    url=env("DATABASE_URL")
}

enum Importance{
    NORMAL
    IMPORTANT
    CRITICAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id          String     @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime? 
  importance  Importance @default(NORMAL)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, date])
}